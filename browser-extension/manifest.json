{
  "manifest_version": 3,
  "name": "司南 Nanpad - 保存网站账号",
  "version": "0.7.0",
  "description": "主动读取当前网页的登录表单，核对后通过配对连接保存到本机司南密钥库。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html", "default_title": "保存到司南" },
  "icons": { "128": "icon.png" }
}
